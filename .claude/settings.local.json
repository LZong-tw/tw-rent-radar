{
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(*.md)",
      "Read(*.toml)",
      "Read(*.json)",
      "Read(*.yaml)",
      "Read(*.yml)",
      "Read(*.py)",
      "Bash(source .venv/Scripts/activate:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(tw-rent-radar:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git mv:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow:*)",
      "Bash(pre-commit:*)",
      "Bash(playwright install:*)",
      "Bash(rm:*)"
